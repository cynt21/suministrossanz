---
import { nav, categories, site, wa } from '../data/site';
const path = Astro.url.pathname;
const cur = (h: string) => (path === h || (h !== '/' && path.startsWith(h + '/'))) ? 'page' : undefined;
---
<header class="top"><div class="wrap bar">
  <a class="logo" href="/" aria-label={`${site.name}, inicio`}><img src="/logo.png" alt="" width="58" height="44" /><span class="nm">Suministros<br />Hosteleros Sanz</span></a>
  <nav id="menu" class="menu" aria-label="Principal"><ul>
    {nav.map(([n, h]) => (
      <li class={h === '/productos' ? 'has-sub' : ''}>
        <a href={h} aria-current={cur(h)}>{n}</a>
        {h === '/productos' && <ul class="sub">{categories.map(c => <li><a href={`/productos/${c.slug}`}>{c.name}</a></li>)}</ul>}
      </li>))}
  </ul></nav>
  <div class="hd">
    <a class="btn alt" href={`tel:${site.phones[2].tel}`} aria-label="Llamar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg><span class="tx">Llamar</span></a>
    <a class="btn alt" href={wa('Hola, quería consultar un producto.')} aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7z"/><path d="M9 9c.5 2.5 2.5 4.5 5 5l1.2-1.2-1.8-1-.8.8c-1-.4-1.8-1.2-2.2-2.2l.8-.8-1-1.8z" fill="currentColor" stroke="none"/></svg><span class="tx">WhatsApp</span></a>
    <button class="burger" aria-expanded="false" aria-controls="menu">Menú</button>
  </div>
</div></header>
<script>
  const b = document.querySelector('.burger'), m = document.getElementById('menu');
  b?.addEventListener('click', () => { const o = m!.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
</script>
